style.fill: transparent   # d2 otherwise paints an opaque theme-coloured page rect
**.style.font-size: 13
**.style.font-color: "#1a1a1a"
(** -> **)[*].style.stroke: "#6b6b6b"
(** -> **)[*].style.font-color: "#6b6b6b"
(** -> **)[*].style.font-size: 13
classes: {
  client: { style: { fill: "#e8effc"; stroke: "#3b6fd4"; stroke-width: 2 } }
  svc:    { style: { fill: "#ece4f7"; stroke: "#7c4dbd"; stroke-width: 2 } }
  store:  { style: { fill: "#e3f5e3"; stroke: "#3f9142"; stroke-width: 2 } }
  cache:  { style: { fill: "#fdf0d5"; stroke: "#d99a2b"; stroke-width: 2 } }
  ext:    { style: { fill: "#fdecec"; stroke: "#c0392b"; stroke-width: 2 } }
  grp:    { style: { fill: "#faf8f4"; stroke: "#d9d4c8"; stroke-width: 2; font-color: "#b5541f" } }
  # NEW / CHANGED emphasis. Stroke-only so it composes: class: [svc; new].
  # NB: double-border is rejected on sql_table/class shapes, so accent + weight only.
  new:    { style: { stroke: "#b5541f"; stroke-width: 4 } }
  changed:{ style: { stroke: "#b5541f"; stroke-width: 3; stroke-dash: 4 } }
}
