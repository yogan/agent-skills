shape: sequence_diagram
editor: Editor { class: client }
api: GraphQL API { class: svc }
gw: Presence Gateway {
  class: svc
  tooltip: new in this MR
  tooltip.near: bottom-right
}
redis: Redis { class: cache }

editor -> api: "mutation joinDocument(id: 42)"
api -> editor: "presenceToken (60s TTL)"
editor -> gw: "WS upgrade · Bearer …"
gw -> gw: "authenticate(token)"
gw -> redis: "SUBSCRIBE doc:42"
gw -> editor: "presence.update on peer join"
