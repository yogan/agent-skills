connecting: { class: client }
authenticating: { class: client }
live: { class: store }
backoff: reconnect backoff {
  class: cache
  tooltip: new retry path
  tooltip.near: bottom-left
}
closed: { class: ext }

connecting -> authenticating: socket open
authenticating -> live: token ok
authenticating -> closed: 401 invalid
live -> backoff: transport error
backoff -> connecting: retry (max 30s)
backoff -> closed: max attempts
live -> closed: user leaves
