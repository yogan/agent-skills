direction: down
users: {
  shape: sql_table
  style: { fill: "#2c6b30"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  id: uuid {constraint: primary_key}
  email: text
  display_name: text
}
documents: {
  shape: sql_table
  tooltip: gains a revision column
  tooltip.near: top-left
  style: { fill: "#2c6b30"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  id: uuid {constraint: primary_key}
  owner_id: uuid {constraint: foreign_key}
  title: text
  revision: bigint
}
presence_sessions: {
  shape: sql_table
  tooltip: new table
  tooltip.near: top-right
  style: { fill: "#6a3fa8"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  id: uuid {constraint: primary_key}
  document_id: uuid {constraint: foreign_key}
  user_id: uuid {constraint: foreign_key}
  socket_id: text
  last_seen_at: timestamptz
}
documents.owner_id -> users.id: belongs to
presence_sessions.document_id -> documents.id: 1 doc : n sessions
presence_sessions.user_id -> users.id: 1 user : n sessions
