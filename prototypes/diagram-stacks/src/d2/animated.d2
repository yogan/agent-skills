# A zero-downtime cutover. The animation IS the explanation: every board is a DIFFERENT
# topology, so what the reader learns is the ORDER of the migration and what is live at each
# moment. One static diagram cannot say "both paths run at once, then the old one is removed".
direction: right
editor: Editor { class: client }
api: GraphQL API { class: svc }
pg: PostgreSQL { class: store; shape: cylinder }

editor -> api: poll every 5s
api -> pg

# d2 does NOT render board names into the SVG, so without this the viewer cannot tell which
# phase is on screen. A borderless caption node, relabelled per step, supplies it.
caption: "phase 1 of 4 — today: polling only" {
  near: top-center
  style: { stroke-width: 0; fill: transparent; font-size: 15; font-color: "#b5541f"; bold: true }
}

steps: {
  "1": {
    (editor -> api)[0].style.stroke-width: 3
  }
  "2": {
    caption.label: "phase 2 of 4 — deploy gateway, no traffic yet"
    gw: Presence Gateway { class: [svc; new] }
    redis: Redis { class: [cache; new]; shape: cylinder }
    gw -> redis: subscribe
    gw -> pg: upsert
  }
  "3": {
    caption.label: "phase 3 of 4 — dual-run, 10% of clients on WebSocket"
    editor -> gw: WebSocket 10%
    (editor -> gw)[0].style.stroke-width: 3
  }
  "4": {
    caption.label: "phase 4 of 4 — cutover complete, polling path removed"
    (editor -> api)[0]: null
    (editor -> gw)[0].label: WebSocket 100%
  }
}
