direction: down
PresenceGateway: {
  shape: sql_table
  style: { fill: "#6a3fa8"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  "+ handleUpgrade()": Socket
  "+ onMessage()": void
  "- authenticate()": Session
}
SessionRegistry: {
  shape: sql_table
  style: { fill: "#6a3fa8"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  "+ add()": void
  "+ dropStale()": int
  "+ forDocument()": "Session[]"
}
Broadcaster: {
  shape: sql_table
  tooltip: new interface
  tooltip.near: bottom-left
  style: { fill: "#a32b1f"; stroke: "#fffffe"; font-color: "#fffffd"; stroke-dash: 3; font-size: 14 }
  "«interface»": ""
  "+ publish()": void
  "+ subscribe()": void
}
RedisFanout: {
  shape: sql_table
  style: { fill: "#7a5410"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  "+ publish()": void
}
PresenceEvent: {
  shape: sql_table
  style: { fill: "#2c6b30"; stroke: "#fffffe"; font-color: "#fffffd"; font-size: 14 }
  userId: uuid
  kind: "join|move|leave"
}
PresenceGateway -> SessionRegistry: owns
PresenceGateway -> Broadcaster: uses {style.stroke-dash: 3}
RedisFanout -> Broadcaster: implements {style.stroke-dash: 3}
SessionRegistry -> PresenceEvent: emits
