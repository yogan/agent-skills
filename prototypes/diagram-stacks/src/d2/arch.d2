browser: Browser {
  class: grp
  editor: Editor { class: client }
  wsc: usePresence() { class: client }
}
k8s: Kubernetes cluster {
  class: grp
  api: api deploy ×3 {
    class: grp
    pod: GraphQL API { class: svc }
  }
  presence: presence deploy ×2 {
    class: grp
    pod: Presence Gateway {
      class: svc
      tooltip: new service
      tooltip.near: center-right
    }
  }
  redis: Redis {
    class: cache
    shape: cylinder
    tooltip: now fans out presence
    tooltip.near: center-right
  }
}
pg: PostgreSQL { class: store; shape: cylinder }
idp: OIDC provider { class: ext; shape: hexagon }

browser.editor -> k8s.api.pod: GraphQL
browser.wsc -> k8s.presence.pod: WebSocket
k8s.api.pod -> pg
k8s.presence.pod -> k8s.redis: publish
k8s.redis -> k8s.presence.pod: fan-out
k8s.presence.pod -> pg: upsert
k8s.api.pod -> idp: verify JWT
