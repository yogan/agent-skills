From acd71fe64f1f4a9b9790688162331044c8ec0567 Mon Sep 17 00:00:00 2001
From: "Blendinger, Frank - AB12345" <frank@e2e.test>
Date: Tue, 4 Aug 2026 18:06:04 +0200
Subject: [PATCH 2/2] use the query-key factories in every discussions/comments
 hook

Replaces the repeated key literals. updateDiscussion now refetches the discussions
namespace after a successful update instead of naming the single detail query.
---
 src/features/comments/api/createComment.ts      | 12 +++++++-----
 src/features/comments/api/deleteComment.ts      | 10 ++++++----
 src/features/comments/api/getComments.ts        |  4 +++-
 .../discussions/api/createDiscussion.ts         | 12 +++++++-----
 .../discussions/api/deleteDiscussion.ts         | 12 +++++++-----
 src/features/discussions/api/getDiscussion.ts   |  4 +++-
 src/features/discussions/api/getDiscussions.ts  |  4 +++-
 .../discussions/api/updateDiscussion.ts         | 17 +++++++++--------
 8 files changed, 45 insertions(+), 30 deletions(-)

diff --git a/src/features/comments/api/createComment.ts b/src/features/comments/api/createComment.ts
index 903c661..423d863 100644
--- a/src/features/comments/api/createComment.ts
+++ b/src/features/comments/api/createComment.ts
@@ -6,6 +6,8 @@ import { useNotificationStore } from '@/stores/notifications';
 
 import { Comment } from '../types';
 
+import { queryKeys } from './query-keys';
+
 export type CreateCommentDTO = {
   data: {
     body: string;
@@ -29,13 +31,13 @@ export const useCreateComment = ({ config, discussionId }: UseCreateCommentOptio
   return useMutation({
     onMutate: async (newComment) => {
       await queryClient.cancelQueries({
-        queryKey: ['comments', discussionId],
+        queryKey: queryKeys.list(discussionId),
       });
 
-      const previousComments = queryClient.getQueryData<Comment[]>(['comments', discussionId]);
+      const previousComments = queryClient.getQueryData<Comment[]>(queryKeys.list(discussionId));
 
       queryClient.setQueryData(
-        ['comments', discussionId],
+        queryKeys.list(discussionId),
         [...(previousComments || []), newComment.data]
       );
 
@@ -43,12 +45,12 @@ export const useCreateComment = ({ config, discussionId }: UseCreateCommentOptio
     },
     onError: (_, __, context: any) => {
       if (context?.previousComments) {
-        queryClient.setQueryData(['comments', discussionId], context.previousComments);
+        queryClient.setQueryData(queryKeys.list(discussionId), context.previousComments);
       }
     },
     onSuccess: () => {
       queryClient.invalidateQueries({
-        queryKey: ['comments', discussionId],
+        queryKey: queryKeys.list(discussionId),
       });
       addNotification({
         type: 'success',
